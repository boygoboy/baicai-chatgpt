# 项目信息 
VUE_APP_NAME = baicai-gpt

# 环境信息
# optional value: development , production
VUE_APP_ENV=development

# server信息 （本地代理地址）
VUE_APP_SERVER=http://localhost
VUE_APP_SERVER_PORT=443

# api信息（后端请求地址）
# VUE_APP_API=http://localhost:81
# VUE_APP_WS_API=ws://localhost:81

VUE_APP_API=http://10.0.0.140:81
VUE_APP_WS_API=ws://10.0.0.140:81
# VUE_APP_API=http://192.168.2.230:81
# VUE_APP_WS_API=ws://192.168.2.230:81
# VUE_APP_API=http://192.168.2.7:81
# VUE_APP_WS_API=ws://192.168.2.7:81

# 页面访问信息
VUE_APP_HOST=http://localhost
VUE_APP_PORT=8801
VUE_APP_PATH=http://localhost:8801

# optional value: proxy, direct （如果设置proxy 需要启动代理服务，目录serve/proxy.js）
VUE_APP_API_MODE=direct